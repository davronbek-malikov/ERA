DATABASE_URL=""
NEXT_PUBLIC_APP_URL=""
AUTH_SECRET=""
NODE_ENV="development"

SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_VIDEOS_BUCKET=""
SUPABASE_STORAGE_PUBLIC_BUCKET=""

# --- ERA AI Agent Engine (docs/ERA_AI_PROVIDER_CONFIGURATION.md) ---------------------------------------
# Provider: "anthropic" (recommended), "openai", "groq" or "ollama" (local development). Leave empty to keep AI off.
ERA_LLM_PROVIDER=""
# Model id. Optional for anthropic (default "claude-opus-5-5"); required for openai and ollama.
ERA_MODEL_NAME=""
# Anthropic: the SDK reads ANTHROPIC_API_KEY (or ANTHROPIC_AUTH_TOKEN / an `ant auth login` profile).
ANTHROPIC_API_KEY=""
# Optional Claude settings: effort low|medium|high|xhigh|max (empty string = omit); refusal fallback on/off.
ERA_AI_EFFORT=""
ERA_AI_ANTHROPIC_FALLBACKS=""
# OpenAI: OPENAI_API_KEY (ERA_API_KEY is still accepted for older setups). OPENAI_BASE_URL is optional.
OPENAI_API_KEY=""
ERA_API_KEY=""
OPENAI_BASE_URL=""
# Groq (OpenAI-compatible API): GROQ_API_KEY; default model "openai/gpt-oss-120b"; GROQ_BASE_URL is optional.
GROQ_API_KEY=""
# Ollama (local only)
OLLAMA_BASE_URL=""
# Limits (defaults in brackets): answer size [8000 tokens], history [12 messages], per-minute burst [8],
# daily requests per user: student [100], teacher [200], admin [200]; daily tokens per user [500000].
ERA_AI_MAX_OUTPUT_TOKENS=""
ERA_AI_MAX_HISTORY_MESSAGES=""
ERA_AI_REQUESTS_PER_MINUTE=""
ERA_AI_DAILY_REQUESTS_STUDENT=""
ERA_AI_DAILY_REQUESTS_TEACHER=""
ERA_AI_DAILY_REQUESTS_ADMIN=""
ERA_AI_DAILY_TOKENS_PER_USER=""
# Optional price override in USD per million tokens (otherwise built-in Claude prices; other models: cost not recorded).
ERA_AI_PRICE_INPUT_PER_MTOK=""
ERA_AI_PRICE_OUTPUT_PER_MTOK=""

EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT=""
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM=""

# --- ERA Knowledge Base / RAG (docs/ERA_KNOWLEDGE_BASE.md) ---------------------------------------------
# Embedding provider: "voyage" (recommended), "openai" or "ollama". Leave empty to keep retrieval off.
# ("test" exists only for the automated test suite and is refused in production.)
ERA_EMBEDDING_PROVIDER=""
# Voyage AI key (when ERA_EMBEDDING_PROVIDER=voyage). OpenAI uses OPENAI_API_KEY above.
VOYAGE_API_KEY=""
# Optional: model (voyage default "voyage-3.5", openai default "text-embedding-3-small"; required for ollama)
ERA_EMBEDDING_MODEL=""
# Optional: vector size (voyage default 1024, openai default 1536)
ERA_EMBEDDING_DIMENSIONS=""
# Optional tuning (defaults in brackets): batch [64], retries [2], max file [20 MB],
# chunk size [1200 chars], overlap [200], top-K passages [5], minimum similarity [0.25]
ERA_EMBEDDING_BATCH_SIZE=""
ERA_EMBEDDING_RETRIES=""
ERA_KB_MAX_FILE_MB=""
ERA_KB_CHUNK_SIZE=""
ERA_KB_CHUNK_OVERLAP=""
ERA_KB_TOP_K=""
ERA_KB_MIN_SCORE=""

# --- Student Management & Payments (docs/ERA_STUDENT_MANAGEMENT.md) ---
# Platform timezone for course dates, due dates and exams (default Asia/Seoul).
ERA_TIMEZONE=""
