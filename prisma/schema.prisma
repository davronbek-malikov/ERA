generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  /// pgvector stores Knowledge Base embeddings (Prompt 09). Available on Supabase and in `prisma dev`.
  extensions = [vector]
}

enum CourseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum LearningGoal {
  AI
  MATHEMATICS
  ENGLISH
  EXAM_PREPARATION
}

enum TimeAvailability {
  LIGHT
  MODERATE
  FOCUSED
  INTENSIVE
}

enum OnboardingStage {
  WELCOME
  PROFILE
  ASSESSMENT
  PLAN
  COMPLETED
}

enum ActivityType {
  SUBJECT_CREATED
  CATEGORY_CREATED
  COURSE_CREATED
  LESSON_CREATED
  USER_CREATED
  ENROLLMENT_CREATED
  SETTINGS_UPDATED
  STUDY_SESSION
  LESSON_COMPLETED
  PRACTICE_SUBMITTED
}

enum ChatMessageRole {
  USER
  ASSISTANT
}

/// Which ERA agent a conversation or usage record belongs to (Prompt 08).
enum AiAgent {
  STUDENT_TUTOR
  TEACHER_ASSISTANT
  ADMIN_ASSISTANT
}

/// Who a Knowledge Base document is for (Prompt 09, docs/ERA_KNOWLEDGE_BASE.md).
enum KnowledgeScope {
  PLATFORM
  COURSE
  LESSON
  TEACHER_PRIVATE
}

/// STUDENTS: may be retrieved for enrolled students. TEACHERS_ONLY: answer keys, assessment material, teacher notes.
enum KnowledgeVisibility {
  STUDENTS
  TEACHERS_ONLY
}

enum KnowledgeStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AiUsageStatus {
  SUCCESS
  FAILED
  CANCELLED
  BLOCKED
}

enum PracticeExerciseType {
  CODING
  MINI_PROJECT
}

enum SubmissionStatus {
  PASSED
  FAILED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  passwordHash String?
  image        String?
  role         UserRole @default(STUDENT)
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollments         Enrollment[]
  instructorProfile   Instructor?
  lessonCompletions   LessonCompletion[]
  chatMessages        ChatMessage[]
  aiConversations     AiConversation[]
  aiUsageEvents       AiUsageEvent[]
  knowledgeDocuments  KnowledgeDocument[]
  uploadedMaterials   CourseMaterial[]
  activities          ActivityLog[]
  passwordResetCodes  PasswordResetCode[]
  onboarding          UserOnboarding?
  pathProgress        UserPathProgress[]
  xpProfile           UserXp?
  streakProfile       Streak?
  badges              Badge[]
  practiceSubmissions PracticeSubmission[]
  courseReviews       CourseReview[]
}

model UserOnboarding {
  id                              String            @id @default(cuid())
  userId                          String            @unique
  goal                            LearningGoal?
  level                           CourseDifficulty?
  recommendedLevel                CourseDifficulty?
  timeAvailability                TimeAvailability?
  stage                           OnboardingStage   @default(WELCOME)
  assessmentScore                 Int?
  assessmentAnswers               Json?
  recommendedSubjectSlug          String?
  recommendedCourseId             String?
  personalizedPlan                String[]
  checklistProfileCompleted       Boolean           @default(false)
  checklistFirstLessonCompleted   Boolean           @default(false)
  checklistFirstPracticeCompleted Boolean           @default(false)
  completedAt                     DateTime?
  createdAt                       DateTime          @default(now())
  updatedAt                       DateTime          @updatedAt

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendedCourse Course? @relation("OnboardingRecommendedCourse", fields: [recommendedCourseId], references: [id], onDelete: SetNull)

  @@index([stage, updatedAt])
  @@index([goal, recommendedLevel])
}

model PasswordResetCode {
  id        String    @id @default(cuid())
  userId    String
  email     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([email, expiresAt])
}

model Instructor {
  id        String   @id @default(cuid())
  userId    String?  @unique
  name      String
  slug      String   @unique
  title     String?
  bio       String?
  imageUrl  String?
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  courses Course[]
}

model Subject {
  id           String            @id @default(cuid())
  name         String
  slug         String            @unique
  description  String?
  thumbnailUrl String?
  status       PublicationStatus @default(PUBLISHED)
  position     Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  categories Category[]

  @@index([status, position])
}

model Category {
  id          String            @id @default(cuid())
  subjectId   String
  name        String
  slug        String
  description String?
  status      PublicationStatus @default(PUBLISHED)
  position    Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  courses Course[]

  @@unique([subjectId, slug])
  @@index([subjectId, status, position])
}

model Course {
  id               String            @id @default(cuid())
  categoryId       String
  instructorId     String
  title            String
  subtitle         String?
  slug             String            @unique
  shortDescription String?
  description      String?
  thumbnailUrl     String?
  promoVideoUrl    String?
  difficulty       CourseDifficulty  @default(BEGINNER)
  outcomes         String[]
  isFeatured       Boolean           @default(false)
  isPopular        Boolean           @default(false)
  homepagePriority Int               @default(0)
  viewCount        Int               @default(0)
  status           PublicationStatus @default(PUBLISHED)
  position         Int               @default(0)
  publishedAt      DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  category                 Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  instructor               Instructor          @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  modules                  CourseModule[]
  lessons                  Lesson[]
  materials                CourseMaterial[]
  enrollments              Enrollment[]
  chatMessages             ChatMessage[]
  aiConversations          AiConversation[]
  knowledgeDocuments       KnowledgeDocument[]
  viewEvents               CourseViewEvent[]
  reviews                  CourseReview[]
  recommendedForOnboarding UserOnboarding[]    @relation("OnboardingRecommendedCourse")
  learningPathEntries      PathCourse[]
  currentForPathProgress   UserPathProgress[]  @relation("CurrentPathCourse")
  nextForPathProgress      UserPathProgress[]  @relation("NextPathCourse")

  @@index([categoryId, status, position])
  @@index([instructorId])
  @@index([difficulty])
  @@index([isFeatured])
  @@index([isPopular])
  @@index([status, publishedAt])
  @@index([status, viewCount])
  @@index([homepagePriority])
}

model CourseReview {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId, createdAt])
  @@index([userId, createdAt])
  @@map("course_reviews")
}

model LearningPath {
  id          String            @id @default(cuid())
  title       String
  slug        String            @unique
  description String?
  subjectSlug String?
  difficulty  CourseDifficulty?
  status      PublicationStatus @default(PUBLISHED)
  position    Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  courses      PathCourse[]
  userProgress UserPathProgress[]

  @@index([status, position])
  @@map("learning_paths")
}

model PathCourse {
  id         String   @id @default(cuid())
  pathId     String
  courseId   String
  position   Int
  stageLabel String?
  createdAt  DateTime @default(now())

  path   LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  course Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([pathId, courseId])
  @@unique([pathId, position])
  @@index([courseId])
  @@map("path_courses")
}

model UserPathProgress {
  id                   String   @id @default(cuid())
  userId               String
  pathId               String
  progressPercent      Int      @default(0)
  completedCourseCount Int      @default(0)
  currentCourseId      String?
  nextCourseId         String?
  lastSyncedAt         DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  path          LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  currentCourse Course?      @relation("CurrentPathCourse", fields: [currentCourseId], references: [id], onDelete: SetNull)
  nextCourse    Course?      @relation("NextPathCourse", fields: [nextCourseId], references: [id], onDelete: SetNull)

  @@unique([userId, pathId])
  @@index([pathId, progressPercent])
  @@index([currentCourseId])
  @@index([nextCourseId])
  @@map("user_path_progress")
}

model CourseViewEvent {
  id        String   @id @default(cuid())
  courseId  String
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
  @@index([createdAt])
}

model CourseModule {
  id          String            @id @default(cuid())
  courseId    String
  title       String
  slug        String
  description String?
  position    Int
  status      PublicationStatus @default(PUBLISHED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, slug])
  @@unique([courseId, position])
  @@index([courseId, status, position])
}

model Lesson {
  id          String            @id @default(cuid())
  courseId    String
  moduleId    String?
  title       String
  slug        String
  description String?
  videoUrl    String?
  duration    String?
  position    Int
  status      PublicationStatus @default(PUBLISHED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  course             Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module             CourseModule?        @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  materials          CourseMaterial[]
  completions        LessonCompletion[]
  content            LessonContent?
  chatMessages       ChatMessage[]
  knowledgeDocuments KnowledgeDocument[]
  subskills          LessonSubskill[]
  quizQuestions      LessonQuizQuestion[]
  practiceExercises  PracticeExercise[]
  currentEnrollments Enrollment[]         @relation("EnrollmentCurrentLesson")

  @@unique([courseId, slug])
  @@unique([courseId, position])
  @@index([moduleId, status, position])
  @@index([courseId, status, position])
}

model LessonContent {
  id                 String   @id @default(cuid())
  lessonId           String   @unique @map("lesson_id")
  overview           String?
  content            String
  practicePrompt     String?  @map("practice_prompt")
  practiceChecklist  String[] @map("practice_checklist")
  learningObjectives String[] @map("learning_objectives")
  keyPoints          String[] @map("key_points")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("lesson_content")
}

model LessonSubskill {
  id          String   @id @default(cuid())
  lessonId    String
  title       String
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, position])
}

model LessonQuizQuestion {
  id            String   @id @default(cuid())
  lessonId      String
  prompt        String
  options       String[]
  correctOption Int
  explanation   String?
  position      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, position])
}

/// Messages of every ERA agent. Student Tutor messages are threaded by (user, lesson) as before and keep
/// course/lesson set; Teacher and Admin messages belong to an AiConversation. Prompt 08 made courseId and
/// lessonId optional and added agent/conversationId: additive, existing rows are unchanged.
model ChatMessage {
  id             String          @id @default(cuid())
  userId         String          @map("user_id")
  courseId       String?         @map("course_id")
  lessonId       String?         @map("lesson_id")
  conversationId String?         @map("conversation_id")
  agent          AiAgent         @default(STUDENT_TUTOR)
  role           ChatMessageRole
  content        String
  createdAt      DateTime        @default(now()) @map("created_at")

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course?         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson       Lesson?         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  conversation AiConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Knowledge Base sources the answer was grounded in (assistant messages only; Prompt 09).
  sources      Json?

  @@index([userId, lessonId, createdAt])
  @@index([courseId, lessonId, createdAt])
  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

/// A Teacher or Admin assistant conversation. Owned by exactly one user; never shared.
model AiConversation {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  agent     AiAgent
  title     String
  courseId  String?  @map("course_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@index([userId, agent, updatedAt])
  @@map("ai_conversations")
}

/// One AI request, recorded by the server. Token counts are provider-reported when `usageSource` is
/// "provider"; cost is null when no price is configured for the model (never invented).
model AiUsageEvent {
  id               String        @id @default(cuid())
  userId           String        @map("user_id")
  agent            AiAgent
  provider         String
  model            String
  conversationId   String?       @map("conversation_id")
  inputTokens      Int?          @map("input_tokens")
  outputTokens     Int?          @map("output_tokens")
  usageSource      String        @map("usage_source")
  estimatedCostUsd Decimal?      @map("estimated_cost_usd") @db.Decimal(12, 6)
  durationMs       Int           @map("duration_ms")
  status           AiUsageStatus
  errorCode        String?       @map("error_code")
  createdAt        DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([agent, createdAt])
  @@map("ai_usage_events")
}

model CourseMaterial {
  id              String   @id @default(cuid())
  courseId        String
  lessonId        String?
  createdByUserId String
  title           String
  description     String?
  fileUrl         String
  storagePath     String?
  mimeType        String?
  position        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson    Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  createdBy User    @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([courseId, position])
  @@index([lessonId, position])
  @@index([createdByUserId])
}

model LessonCompletion {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model Enrollment {
  id              String   @id @default(cuid())
  userId          String
  courseId        String
  progress        Int      @default(0)
  currentLessonId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course        Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  currentLesson Lesson? @relation("EnrollmentCurrentLesson", fields: [currentLessonId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([currentLessonId])
}

model ActivityLog {
  id        String       @id @default(cuid())
  type      ActivityType
  message   String
  userId    String?
  context   Json?
  createdAt DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([type])
}

model SiteSetting {
  id                   String   @id
  platformName         String
  supportEmail         String?
  defaultPromoVideoUrl String?
  description          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model UserXp {
  id             String   @id @default(cuid())
  userId         String   @unique
  totalXp        Int      @default(0)
  level          Int      @default(1)
  currentLevelXp Int      @default(0)
  nextLevelXp    Int      @default(100)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([level, totalXp])
  @@map("user_xp")
}

model Streak {
  id             String    @id @default(cuid())
  userId         String    @unique
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([currentStreak, longestStreak])
  @@map("streak")
}

model Badge {
  id          String   @id @default(cuid())
  userId      String
  code        String
  title       String
  description String?
  icon        String?
  earnedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([userId, earnedAt])
  @@map("badges")
}

model PracticeExercise {
  id            String               @id @default(cuid())
  lessonId      String
  type          PracticeExerciseType @default(CODING)
  title         String
  slug          String
  instructions  String
  language      String               @default("javascript")
  starterCode   String
  solutionCode  String
  hints         String[]
  solutionNotes String?
  testCases     Json
  position      Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  lesson      Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions PracticeSubmission[]

  @@unique([lessonId, slug])
  @@index([lessonId, position])
  @@map("practice_exercises")
}

model PracticeSubmission {
  id          String           @id @default(cuid())
  exerciseId  String
  userId      String
  language    String           @default("javascript")
  code        String
  status      SubmissionStatus
  passedCount Int              @default(0)
  totalTests  Int              @default(0)
  feedback    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  exercise PracticeExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([exerciseId, createdAt])
  @@index([userId, createdAt])
  @@map("practice_submissions")
}

/// An uploaded educational document (Prompt 09). The file lives in the private storage bucket; its text is split
/// into KnowledgeChunk rows with embeddings. Access is decided by scope + visibility + course/lesson ownership.
model KnowledgeDocument {
  id                  String              @id @default(cuid())
  title               String
  originalFilename    String              @map("original_filename")
  fileType            String              @map("file_type")
  mimeType            String              @map("mime_type")
  fileSize            Int                 @map("file_size")
  storagePath         String              @map("storage_path")
  contentHash         String              @map("content_hash")
  scope               KnowledgeScope
  visibility          KnowledgeVisibility @default(STUDENTS)
  courseId            String?             @map("course_id")
  lessonId            String?             @map("lesson_id")
  uploadedById        String              @map("uploaded_by_id")
  status              KnowledgeStatus     @default(PENDING)
  errorCode           String?             @map("error_code")
  errorMessage        String?             @map("error_message")
  pageCount           Int?                @map("page_count")
  sectionCount        Int?                @map("section_count")
  chunkCount          Int                 @default(0) @map("chunk_count")
  embeddingModel      String?             @map("embedding_model")
  embeddingDimensions Int?                @map("embedding_dimensions")
  attempts            Int                 @default(0)
  processingStartedAt DateTime?           @map("processing_started_at")
  processedAt         DateTime?           @map("processed_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  course     Course?          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson     Lesson?          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  uploadedBy User             @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  chunks     KnowledgeChunk[]

  @@index([scope, courseId])
  @@index([lessonId])
  @@index([uploadedById])
  @@index([contentHash])
  @@map("knowledge_documents")
}

/// One retrievable passage. `embedding` is a pgvector column written and searched with parameterized SQL only.
model KnowledgeChunk {
  id             String                 @id @default(cuid())
  documentId     String                 @map("document_id")
  chunkIndex     Int                    @map("chunk_index")
  content        String
  heading        String?
  pageStart      Int?                   @map("page_start")
  pageEnd        Int?                   @map("page_end")
  charCount      Int                    @map("char_count")
  embeddingModel String                 @map("embedding_model")
  embedding      Unsupported("vector")?
  createdAt      DateTime               @default(now()) @map("created_at")

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([embeddingModel])
  @@map("knowledge_chunks")
}
